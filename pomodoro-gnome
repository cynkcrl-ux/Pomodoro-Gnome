# --------------------------------------------------------------------------
# Paths and small helpers
# --------------------------------------------------------------------------

def _xdg(env, fallback):
    return os.environ.get(env) or os.path.join(os.path.expanduser("~"), fallback)


CONFIG_FILE = os.path.join(_xdg("XDG_CONFIG_HOME", ".config"), "pomodoro-gnome", "settings.json")
STATE_FILE = os.path.join(_xdg("XDG_STATE_HOME", ".local/state"), "pomodoro-gnome", "state.json")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
MPV_SOCKET = os.path.join(RUNTIME_DIR, "pomodoro-gnome-mpv.sock")
MPV_LOG = os.path.join(os.path.dirname(STATE_FILE), "mpv.log")
STATS_FILE = os.path.join(os.path.dirname(STATE_FILE), "stats.json")


def find_data(rel):
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [os.path.join(here, "data")]
    candidates.append(os.path.join(GLib.get_user_data_dir(), "pomodoro-gnome"))
    candidates += [os.path.join(d, "pomodoro-gnome") for d in GLib.get_system_data_dirs()]
    for base in candidates:
        path = os.path.join(base, rel)
        if os.path.exists(path):
            return path
    return None


def now_ms():
    return time.time() * 1000.0


def clamp_int(value, low, high, fallback):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return fallback
    return max(low, min(high, n))


def format_time(ms):
    total = max(0, math.ceil(ms / 1000.0))
    return "%02d:%02d" % (total // 60, total % 60)


def fmt_minutes(m):
    m = int(m)
    return "%dh %02dm" % (m // 60, m % 60) if m >= 60 else "%d min" % m


def fmt_clock(sec):
    sec = int(max(0, sec))
    return "%d:%02d" % (sec // 60, sec % 60)


def read_json(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
        os.replace(tmp, path)
    except OSError:
        pass


def _die_with_parent():
    # So a crash of the app never leaves music playing.
    try:
        import ctypes
        ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except Exception:
        pass


def spawn_quiet(args, die_with_parent=False):
    proc = subprocess.Popen(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        preexec_fn=_die_with_parent if die_with_parent else None,
    )
    return proc


# --------------------------------------------------------------------------
# Engine: timer, persistence and music. No GTK widgets in here.
# --------------------------------------------------------------------------

class Engine:
    def __init__(self, notify, message=None):
        self.notify = notify
        self.message = message or notify
        self.listeners = []
        self.settings = self._load_settings()

        self.phase = "idle"
        self.running = False
        self.long_break = False
        self.ends_at = 0.0
        self.remaining_ms = 0.0
        self.total_ms = 0.0
        self.sessions_done = 0
        self.now_ms = now_ms()

        self.mpv = None
        self.mpv_started = 0.0
        self.playing_channel = None
        self.music_failures = 0
        self._failure_notified = False
        self._watchdog_id = 0
        self._playing = False
        self._last_pos = None
        self._stalls = 0
        self.now = {}
        self.is_vod = False
        self.user_paused = False
        self._break_paused = False
        self._good_marked = False
        self._profile_idx = clamp_int(self.settings["stream_profile"], 0,
                                      len(PROFILES) - 1, 0)
        self._stats = read_json(STATS_FILE)
        if not isinstance(self._stats, dict):
            self._stats = {}
        self._tick_id = 0
        self._retry_id = 0
        self._restart_id = 0

        self._restore_state()
        self._schedule()
        self.sync_music()

    # ---- settings ---------------------------------------------------------

    def _load_settings(self):
        saved = read_json(CONFIG_FILE)
        merged = json.loads(json.dumps(DEFAULT_SETTINGS))
        if isinstance(saved, dict):
            merged.update({k: v for k, v in saved.items() if k in merged})
        if not isinstance(merged["channels"], list):
            merged["channels"] = json.loads(json.dumps(DEFAULT_CHANNELS))
        return merged

    def _save_settings(self):
        write_json(CONFIG_FILE, self.settings)

    @property
    def focus_minutes(self):
        return clamp_int(self.settings["focus_minutes"], 1, 600, 25)

    @property
    def break_minutes(self):
        return clamp_int(self.settings["break_minutes"], 1, 120, 5)

    @property
    def long_break_minutes(self):
        return clamp_int(self.settings["long_break_minutes"], 1, 120, 15)

    @property
    def volume(self):
        return clamp_int(self.settings["volume"], 0, 100, 60)

    @property
    def channel(self):
        return self.settings["channel"] or ""

    @property
    def channels(self):
        return [c for c in self.settings["channels"]
                if isinstance(c, dict) and c.get("url")]

    def set_setting(self, key, value):
        self.settings[key] = value
        self._save_settings()
        self.sync_music()
        self._emit("settings")
        self._emit("state")

    def set_volume(self, value):
        value = clamp_int(value, 0, 100, 60)
        self.settings["volume"] = value
        self._save_settings()
        self._mpv_command("set_property", "volume", value)

    def add_channel(self, name, url):
        url = (url or "").strip()
        if not URL_RE.match(url):
            return False
        name = (name or "").strip() or "Channel %d" % (len(self.channels) + 1)
        channels = self.channels + [{"name": name, "url": url}]
        self.settings["channels"] = channels
        if not self.channel:
            self.settings["channel"] = url
        self._save_settings()
        self.sync_music()
        self._emit("settings")
        return True

    def remove_channel(self, index):
        channels = self.channels
        if not 0 <= index < len(channels):
            return
        removed = channels.pop(index)
        self.settings["channels"] = channels
        if removed["url"] == self.channel:
            self.settings["channel"] = channels[0]["url"] if channels else ""
        self._save_settings()
        self.sync_music()
        self._emit("settings")

    def channel_name(self, channel):
        if channel.startswith("ambient:"):
            for amb_id, label, _icon, _src in AMBIENT:
                if channel == "ambient:" + amb_id:
                    return label
        for c in self.channels:
            if c["url"] == channel:
                return c["name"]
        return ""

    # ---- timer ------------------------------------------------------------

    @property
    def paused(self):
        return self.phase != "idle" and not self.running

    @property
    def left_ms(self):
        if self.phase == "idle":
            return self.focus_minutes * 60000.0
        if self.running:
            return max(0.0, self.ends_at - self.now_ms)
        return self.remaining_ms

    @property
    def progress(self):
        if self.phase == "idle" or self.total_ms <= 0:
            return 0.0
        return max(0.0, min(1.0, 1.0 - self.left_ms / self.total_ms))

    def _emit(self, event):
        for fn in list(self.listeners):
            fn(event)

    def _commit(self):
        self._save_state()
        self.sync_music()
        self._schedule()
        self._emit("state")

    def begin_phase(self, nxt, long_break=False):
        if nxt == "break":
            minutes = self.long_break_minutes if long_break else self.break_minutes
        else:
            minutes = self.focus_minutes
        self.phase = nxt
        self.long_break = bool(long_break) and nxt == "break"
        self.total_ms = minutes * 60000.0
        self.remaining_ms = self.total_ms
        self.now_ms = now_ms()
        self.ends_at = self.now_ms + self.remaining_ms
        self.running = True
        self._commit()

    def start_or_pause(self):
        if self.phase == "idle":
            self.begin_phase("focus")
            return
        self.now_ms = now_ms()
        if self.running:
            self.remaining_ms = max(0.0, self.ends_at - self.now_ms)
            self.running = False
        else:
            self.ends_at = self.now_ms + self.remaining_ms
            self.running = True
        self._commit()

    def reset(self):
        self.phase = "idle"
        self.running = False
        self.long_break = False
        self.remaining_ms = 0.0
        self.total_ms = 0.0
        self.sessions_done = 0
        self._commit()

    def skip(self):
        if self.phase != "idle":
            self.finish_phase(silent=True)

    def finish_phase(self, silent=False):
        if self.phase == "focus":
            minutes = self.total_ms / 60000.0
            self.sessions_done += 1
            long_break = self.sessions_done % CYCLE == 0
            if not silent:
                self.record_session(minutes)
                length = self.long_break_minutes if long_break else self.break_minutes
                self._announce("Focus done", "Take a %d minute %s." % (
                    length, "long break" if long_break else "break"))
            self.begin_phase("break", long_break)
        elif self.phase == "break":
            if self.settings["auto_continue"]:
                if not silent:
                    self._announce("Break over",
                                   "Back to focus for %d minutes." % self.focus_minutes)
                self.begin_phase("focus")
            else:
                if not silent:
                    self._announce("Break over",
                                   "Start the next focus session when you're ready.")
                self.phase = "focus"
                self.long_break = False
                self.running = False
                self.total_ms = self.focus_minutes * 60000.0
                self.remaining_ms = self.total_ms
                self._commit()

    def _announce(self, title, body):
        self.notify(title, body)
        if self.settings["chime"]:
            self.play_chime()

    def _schedule(self):
        if self.running and not self._tick_id:
            self._tick_id = GLib.timeout_add(250, self._on_tick)

    def _on_tick(self):
        self.now_ms = now_ms()
        if self.running and self.ends_at - self.now_ms <= 0:
            self.finish_phase()
        else:
            self._emit("state")
        if not self.running:
            self._tick_id = 0
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    # ---- persistence ------------------------------------------------------

    def _save_state(self):
        write_json(STATE_FILE, {
            "phase": self.phase,
            "running": self.running,
            "ends_at": self.ends_at,
            "remaining_ms": self.remaining_ms,
            "total_ms": self.total_ms,
            "sessions_done": self.sessions_done,
            "long_break": self.long_break,
        })

    def _restore_state(self):
        saved = read_json(STATE_FILE)
        if not isinstance(saved, dict):
            return
        phase = saved.get("phase")
        if phase not in ("focus", "break"):
            return
        # A phase that ended while the app was closed isn't resumed.
        if saved.get("running") and saved.get("ends_at", 0) <= now_ms():
            return
        self.sessions_done = clamp_int(saved.get("sessions_done"), 0, 10 ** 6, 0)
        self.phase = phase
        self.long_break = bool(saved.get("long_break")) and phase == "break"
        self.total_ms = float(saved.get("total_ms") or 0) or (
            (self.break_minutes if phase == "break" else self.focus_minutes) * 60000.0)
        self.now_ms = now_ms()
        if saved.get("running"):
            self.ends_at = float(saved["ends_at"])
            self.remaining_ms = max(0.0, self.ends_at - self.now_ms)
            self.running = True
        else:
            self.remaining_ms = float(saved.get("remaining_ms") or 0)
            self.running = False

    # ---- music ------------------------------------------------------------

    @property
    def music_wanted(self):
        if not self.running or not self.channel:
            return False
        if self.phase == "break" and self.settings["stop_music_on_break"]:
            return False
        return True

    @property
    def music_status(self):
        if self._break_paused:
            return "Paused during break"
        if not self.music_wanted:
            return ""
        if self.user_paused:
            return "Paused"
        if self._retry_id or self._restart_id:
            return "Reconnecting…"
        if self.mpv:
            return "Playing" if self._playing else "Connecting…"
        return ""

    def _source(self, channel):
        if channel.startswith("ambient:"):
            for amb_id, _label, _icon, src in AMBIENT:
                if channel == "ambient:" + amb_id:
                    return find_data(src) if src.startswith("sounds/") else src
            return None
        return channel

    def _ytdl_args(self, channel):
        if not channel.startswith("http"):
            return []
        mode = clamp_int(self.settings["stream_mode"], -1, len(PROFILES) - 1, -1)
        idx = self._profile_idx if mode < 0 else mode
        return list(PROFILES[idx][1])

    def _escalate_profile(self):
        mode = clamp_int(self.settings["stream_mode"], -1, len(PROFILES) - 1, -1)
        if mode >= 0 or not self.channel.startswith("http"):
            return
        self._profile_idx = (self._profile_idx + 1) % len(PROFILES)
        self.message("Trying another way to connect",
                     "Using: " + PROFILES[self._profile_idx][0])

    def _remember_profile(self):
        mode = clamp_int(self.settings["stream_mode"], -1, len(PROFILES) - 1, -1)
        if mode < 0 and self.settings["stream_profile"] != self._profile_idx:
            self.settings["stream_profile"] = self._profile_idx
            self._save_settings()

    def set_stream_mode(self, mode):
        self.settings["stream_mode"] = mode
        self._save_settings()
        if self.mpv:
            self._restart_music()

    def sync_music(self):
        if self.music_wanted:
            if self.mpv and self._break_paused:
                self._break_paused = False
                if not self.user_paused:
                    self._mpv_command("set_property", "pause", False)
                self._ensure_watchdog()
            if self.mpv and self.playing_channel != self.channel:
                self._restart_music()
            elif not self.mpv and not self._retry_id and not self._restart_id:
                self._start_music()
        else:
            self._cancel_retry()
            if self.mpv:
                # A normal video keeps its place across a break; a live stream can't.
                if (self.running and self.phase == "break" and self.channel
                        and self.is_vod):
                    if not self._break_paused:
                        self._break_paused = True
                        self._mpv_command("set_property", "pause", True)
                else:
                    self._stop_music()

    def _cancel_retry(self):
        for attr in ("_retry_id", "_restart_id"):
            source = getattr(self, attr)
            if source:
                GLib.source_remove(source)
                setattr(self, attr, 0)

    def _quit_stale_mpv(self):
        # An mpv left behind by a crash still listens on the socket.
        if not os.path.exists(MPV_SOCKET):
            return
        if self._mpv_command("quit"):
            time.sleep(0.3)

    def _start_music(self):
        channel = self.channel
        source = self._source(channel)
        if not source:
            self.message("Music stopped", "Couldn't find the sound file.")
            return
        self._quit_stale_mpv()
        try:
            os.makedirs(os.path.dirname(MPV_LOG), exist_ok=True)
        except OSError:
            pass
        args = [
            "mpv", "--no-video", "--no-terminal", "--sid=no", "--loop-playlist=inf",
            "--log-file=" + MPV_LOG,
            "--volume=%d" % self.volume,
            "--input-ipc-server=" + MPV_SOCKET,
        ]
        args += self._ytdl_args(channel)
        args += os.environ.get("POMODORO_MPV_EXTRA", "").split()
        args += ["--", source]
        try:
            proc = spawn_quiet(args, die_with_parent=True)
        except FileNotFoundError:
            self.message("Music unavailable",
                         "mpv isn't installed. The timer keeps running.")
            return
        self.mpv = proc
        self.mpv_started = time.time()
        self._playing = False
        self._last_pos = None
        self._stalls = 0
        self._good_marked = False
        self.user_paused = False
        self._break_paused = False
        self.is_vod = False
        self.now = {}
        self.playing_channel = channel
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid, self._mpv_exited, proc)
        self._ensure_watchdog()

    def _ensure_watchdog(self):
        if not self._watchdog_id and self.mpv:
            self._watchdog_id = GLib.timeout_add_seconds(2, self._watchdog)

    def _watchdog(self):
        """Every 2 s: refresh track info, un-pause stray pauses, replace a stalled mpv."""
        if not self.mpv or not self.music_wanted:
            self._watchdog_id = 0
            return GLib.SOURCE_REMOVE
        info = self._mpv_get_many("pause", "time-pos", "duration", "media-title",
                                  "playlist-pos", "playlist-count")
        pos, dur = info.get("time-pos"), info.get("duration")
        self.now = {"title": info.get("media-title"), "pos": pos, "dur": dur,
                    "idx": info.get("playlist-pos"), "count": info.get("playlist-count")}
        self.is_vod = isinstance(dur, (int, float)) and dur > 0
        if info.get("pause") is True and not self.user_paused:
            self._mpv_command("set_property", "pause", False)
            self._stalls = 0
        elif self.user_paused:
            self._stalls = 0
        else:
            age = time.time() - self.mpv_started
            if isinstance(pos, (int, float)) and (
                    self._last_pos is None or pos > self._last_pos + 0.2):
                self._last_pos = pos
                self._stalls = 0
                self._playing = True
                if age > 150 and not self._good_marked:
                    self._good_marked = True
                    self.music_failures = 0
                    self._failure_notified = False
                    self._remember_profile()
            elif age > 15:
                self._stalls += 1
                self._playing = False
                if self._stalls >= 6:  # about 12 s without progress
                    self._on_stall()
        self._emit("state")
        return GLib.SOURCE_CONTINUE

    def _on_stall(self):
        self.music_failures += 1
        self._escalate_profile()
        self._stop_music(force=True)
        self._restart_music()
        if self.music_failures >= len(PROFILES) and not self._failure_notified:
            self._failure_notified = True
            self.message("Music keeps failing",
                         "Update yt-dlp, then check Show Music Log in the menu.")

    def _stop_music(self, force=False):
        proc, self.mpv = self.mpv, None
        self.playing_channel = None
        self._playing = False
        self._break_paused = False
        self.user_paused = False
        self.is_vod = False
        self.now = {}
        if proc:
            try:
                proc.kill() if force else proc.terminate()
            except OSError:
                pass

    def _restart_music(self):
        self._stop_music()
        if self._restart_id:
            GLib.source_remove(self._restart_id)
        self._restart_id = GLib.timeout_add(300, self._after_restart)

    def _after_restart(self):
        self._restart_id = 0
        self.sync_music()
        return GLib.SOURCE_REMOVE

    def replay_music(self):
        """For when audio went away under mpv (e.g. Bluetooth call mode)."""
        self.music_failures = 0
        if self.music_wanted:
            self._restart_music()

    def _mpv_exited(self, _pid, status, proc):
        if proc is not self.mpv:
            return  # we stopped it on purpose
        self.mpv = None
        self.playing_channel = None
        self._playing = False
        if not self.music_wanted:
            return
        age = time.time() - self.mpv_started
        clean = os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0
        if clean and age > 10:
            self.music_failures = 0
            self._retry_id = GLib.timeout_add_seconds(1, self._retry_music)
            return
        if age < 60:
            self._escalate_profile()
        if age > 120:
            self.music_failures = 0
            self._failure_notified = False
        self.music_failures += 1
        delay = (1, 3, 5, 10, 30)[min(self.music_failures, 5) - 1]
        self._retry_id = GLib.timeout_add_seconds(delay, self._retry_music)
        if self.music_failures >= 3 and not self._failure_notified:
            self._failure_notified = True
            name = self.channel_name(self.channel) or "the stream"
            self.message("Music keeps dropping",
                         "Can't hold a connection to %s. Still retrying." % name)

    def _retry_music(self):
        self._retry_id = 0
        self.sync_music()
        return GLib.SOURCE_REMOVE

    def _mpv_get_many(self, *props):
        """Ask mpv for several properties over one connection."""
        result = {}
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(0.5)
            s.connect(MPV_SOCKET)
            for i, prop in enumerate(props):
                s.sendall(json.dumps({"command": ["get_property", prop],
                                      "request_id": 100 + i}).encode() + b"\n")
            buf = b""
            while len(result) < len(props):
                chunk = s.recv(8192)
                if not chunk:
                    break
                buf += chunk
                for line in buf.split(b"\n"):
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    rid = msg.get("request_id")
                    if isinstance(rid, int) and 100 <= rid < 100 + len(props):
                        result[props[rid - 100]] = msg.get("data")
            s.close()
        except OSError:
            pass
        return result

    def _mpv_command(self, *cmd):
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(1)
            s.connect(MPV_SOCKET)
            s.sendall(json.dumps({"command": list(cmd)}).encode() + b"\n")
            s.close()
            return True
        except OSError:
            return False

    # ---- music player controls -------------------------------------------

    def music_toggle_pause(self):
        if not self.mpv:
            return
        self.user_paused = not self.user_paused
        self._mpv_command("set_property", "pause", self.user_paused)
        self._emit("state")

    def music_next(self):
        self._mpv_command("playlist-next")

    def music_prev(self):
        count = self.now.get("count") or 0
        if count > 1 and (self.now.get("pos") or 0) < 5:
            self._mpv_command("playlist-prev")
        else:
            self._mpv_command("seek", 0, "absolute")

    # ---- stats -------------------------------------------------------------

    def record_session(self, minutes):
        day = datetime.date.today().isoformat()
        entry = self._stats.setdefault(day, {"sessions": 0, "minutes": 0})
        entry["sessions"] += 1
        entry["minutes"] += int(round(minutes))
        write_json(STATS_FILE, self._stats)
        self._emit("stats")

    def stats_day(self, day):
        e = self._stats.get(day.isoformat()) or {}
        return {"sessions": int(e.get("sessions", 0)), "minutes": int(e.get("minutes", 0))}

    def streak(self):
        day = datetime.date.today()
        if not self.stats_day(day)["sessions"]:
            day -= datetime.timedelta(days=1)  # today may simply not have started yet
        n = 0
        while self.stats_day(day)["sessions"]:
            n += 1
            day -= datetime.timedelta(days=1)
        return n

    def week(self):
        today = datetime.date.today()
        days = [today - datetime.timedelta(days=i) for i in range(6, -1, -1)]
        return [(d, self.stats_day(d)["minutes"]) for d in days]

    def play_chime(self):
        path = find_data("chime.oga")
        if not path:
            return
        for cmd in (["pw-play", "--volume", "0.7", path],
                    ["paplay", path],
                    ["mpv", "--no-video", "--no-terminal", "--volume=70", path]):
            if shutil.which(cmd[0]):
                try:
                    proc = spawn_quiet(cmd)
                    GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid,
                                         lambda *_a: None)
                except OSError:
                    continue
                return

    def shutdown(self):
        if self._watchdog_id:
            GLib.source_remove(self._watchdog_id)
            self._watchdog_id = 0
        self._cancel_retry()
        self._stop_music()


