    def _refresh_stats(self):
        e = self.engine
        day = e.stats_day(datetime.date.today())
        self.st_sessions.set_label(str(day["sessions"]))
        self.st_minutes.set_label(fmt_minutes(day["minutes"]))
        n = e.streak()
        self.st_streak.set_label("%d day%s" % (n, "" if n == 1 else "s"))
        week = e.week()
        top = max([m for _d, m in week] + [1])
        for i, ((d, m), (bar, lbl)) in enumerate(zip(week, self.week_cols)):
            bar.set_size_request(20, max(4, int(80 * m / top)))
            bar.set_tooltip_text(fmt_minutes(m))
            lbl.set_label(d.strftime("%a")[:1])
            (bar.add_css_class if i == 6 else bar.remove_css_class)("today")

    # ---- music list -------------------------------------------------------

    def _radio_row(self, expander, title, icon, value, subtitle=""):
        row = Adw.ActionRow(title=GLib.markup_escape_text(title),
                            subtitle=GLib.markup_escape_text(subtitle), subtitle_lines=1)
        row.add_prefix(Gtk.Image(icon_name=icon))
        check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
        check.set_group(self._radio_leader)
        check.connect("toggled", self._on_radio_toggled, value)
        row.add_suffix(check)
        row.set_activatable_widget(check)
        expander.add_row(row)
        self._music_rows.append((expander, row))
        self._radios[value] = check

    def _rebuild_music(self):
        snapshot = json.dumps(self.engine.channels)
        if snapshot != self._channel_snapshot:
            self._channel_snapshot = snapshot
            for expander, row in self._music_rows:
                expander.remove(row)
            self._music_rows = []
            self._radios = {}
            for c in self.engine.channels:
                short = re.sub(r"^https?://(www\.)?", "", c["url"])
                self._radio_row(self.src_exp, c["name"], "audio-x-generic-symbolic",
                                c["url"], short)
            self.src_exp.set_visible(bool(self.engine.channels))
            for amb_id, label, icon, _src in AMBIENT:
                self._radio_row(self.amb_exp, label, icon, "ambient:" + amb_id)
            self._radio_row(self.amb_exp, "No music", "audio-volume-muted-symbolic", "")
        self._guard = True
        active = self._radios.get(self.engine.channel) or self._radios.get("")
        if active:
            active.set_active(True)
        self._guard = False
        ch = self.engine.channel
        name = GLib.markup_escape_text(self.engine.channel_name(ch))
        self.src_exp.set_subtitle(name if ch.startswith("http") else "")
        self.amb_exp.set_subtitle(name if ch.startswith("ambient:")
                                  else ("No music" if not ch else ""))

    def _on_radio_toggled(self, check, value):
        if self._guard or not check.get_active():
            return
        self.engine.set_setting("channel", value)

    # ---- focus length -----------------------------------------------------

    def _sync_focus_buttons(self):
        minutes = self.engine.focus_minutes
        key = minutes if minutes in PRESETS else "custom"
        self._guard = True
        self.preset_buttons[key].set_active(True)
        self.custom_row.set_visible(key == "custom")
        if int(self.custom_row.get_value()) != minutes:
            self.custom_row.set_value(minutes)
        self._guard = False

    def _on_preset_toggled(self, btn, minutes):
        if self._guard or not btn.get_active():
            return
        if minutes == "custom":
            self.custom_row.set_visible(True)
            self.engine.set_setting("focus_minutes", int(self.custom_row.get_value()))
        else:
            self.custom_row.set_visible(False)
            self.engine.set_setting("focus_minutes", minutes)

    def _on_custom_changed(self, row, _pspec):
        if self._guard:
            return
        self.engine.set_setting("focus_minutes", int(row.get_value()))

    # ---- updates ----------------------------------------------------------

    def _on_engine(self, event):
        if event == "settings":
            self._rebuild_music()
            self._sync_focus_buttons()
        elif event == "stats":
            self._refresh_stats()
        self._refresh()

    def _eq_step(self):
        playing = self.engine.music_status == "Playing"
        for bar in self.eq_bars:
            bar.set_size_request(4, random.randint(6, 26) if playing else 4)
        return GLib.SOURCE_CONTINUE

    def _refresh(self):
        e = self.engine
        label = {"idle": "Ready", "focus": "Focus",
                 "break": "Long break" if e.long_break else "Break"}[e.phase]
        time_text = format_time(e.left_ms)
        self.time_label.set_label(time_text)
        self.phase_label.set_label(label)
        session = ""
        if e.phase == "focus":
            session = "Session %d" % (e.sessions_done + 1)
        elif e.phase == "break":
            session = "Session %d" % e.sessions_done
        if e.paused:
            session += (" · " if session else "") + "Paused"
        self.session_label.set_label(session)
        self.session_label.set_visible(bool(session))
        self.ring.update(e.progress, e.phase == "break", e.paused,
                         e.running and e.left_ms < 10000)

        filled = CYCLE if (e.phase == "break" and e.long_break) else e.sessions_done % CYCLE
        for i, d in enumerate(self.dots):
            (d.add_css_class if i < filled else d.remove_css_class)("filled")
        for c in ("phase-focus", "phase-break"):
            self.phase_box.remove_css_class(c)
        if e.phase != "idle":
            self.phase_box.add_css_class("phase-" + e.phase)

        if e.running:
            self.play_btn.set_icon_name("media-playback-pause-symbolic")
            self.play_btn.set_tooltip_text("Pause")
        else:
            self.play_btn.set_icon_name("media-playback-start-symbolic")
            self.play_btn.set_tooltip_text("Resume" if e.paused else "Start")
        self.skip_btn.set_sensitive(e.phase != "idle")
        self.reset_btn.set_sensitive(e.phase != "idle")
        self.set_title("%s · %s" % (time_text, label) if e.phase != "idle" else APP_NAME)
        self._refresh_music()

    def _refresh_music(self):
        e = self.engine
        ch = e.channel
        name = e.channel_name(ch)
        status = e.music_status
        if not ch:
            title, sub = "No music", "Pick a source below"
        elif e.mpv:
            title = (name if ch.startswith("ambient:")
                     else e.now.get("title") or name or "Music")
            sub = status or "Starting…"
            count = e.now.get("count")
            if count and count > 1:
                sub += " · Track %d of %d" % ((e.now.get("idx") or 0) + 1, count)
        else:
            title, sub = name or "Music", "Plays while you focus"
        self.np_title.set_label(title)
        self.np_sub.set_label(sub)

        pos, dur = e.now.get("pos"), e.now.get("dur")
        if e.mpv and e.is_vod and isinstance(pos, (int, float)):
            self.np_progress.set_visible(True)
            self.np_progress.set_fraction(max(0.0, min(1.0, pos / dur)))
            self.np_time.set_label("%s / %s" % (fmt_clock(pos), fmt_clock(dur)))
        elif e.mpv and isinstance(pos, (int, float)):
            self.np_progress.set_visible(False)
            self.np_time.set_label("Live stream")
        else:
            self.np_progress.set_visible(False)
            self.np_time.set_label("")
        self.np_time.set_visible(bool(self.np_time.get_label()))
        self.np_prev.set_sensitive(bool(e.mpv and e.is_vod))
        self.np_next.set_sensitive(bool(e.mpv and (e.now.get("count") or 0) > 1))
        self.np_play.set_sensitive(e.mpv is not None)
        self.np_play.set_icon_name("media-playback-start-symbolic" if e.user_paused
                                   else "media-playback-pause-symbolic")

    def _on_close(self, _win):
        # Keep the timer and music going in the background while it runs.
        if self.engine.running:
            self.set_visible(False)
            return True
        return False


class PreferencesDialog(Adw.PreferencesDialog):
    def __init__(self, engine):
        super().__init__(title="Preferences")
        self.engine = engine
        self._channel_rows = []
        s = engine.settings

        page = Adw.PreferencesPage()
        self.add(page)

        timer = Adw.PreferencesGroup(title="Timer")
        page.add(timer)
        brk = Adw.SpinRow(
            title="Break length", subtitle="Minutes",
            adjustment=Gtk.Adjustment(lower=1, upper=120, step_increment=1,
                                      page_increment=5, value=engine.break_minutes))
        brk.connect("notify::value",
                    lambda r, _p: engine.set_setting("break_minutes", int(r.get_value())))
        timer.add(brk)
        longb = Adw.SpinRow(
            title="Long break length", subtitle="Minutes, after every 4th session",
            adjustment=Gtk.Adjustment(lower=1, upper=120, step_increment=1,
                                      page_increment=5, value=engine.long_break_minutes))
        longb.connect("notify::value", lambda r, _p: engine.set_setting(
            "long_break_minutes", int(r.get_value())))
        timer.add(longb)
        for key, title, subtitle in (
            ("stop_music_on_break", "Stop music during breaks",
             "Resumes live when focus starts"),
            ("auto_continue", "Auto-start next focus", "Right after the break"),
            ("chime", "Chime when a timer ends", "Soft two-note sound"),
        ):
            row = Adw.SwitchRow(title=title, subtitle=subtitle, active=bool(s[key]))
            row.connect("notify::active",
                        lambda r, _p, k=key: engine.set_setting(k, r.get_active()))
            timer.add(row)

        conn = Adw.PreferencesGroup(title="Music connection")
        page.add(conn)
        combo = Adw.ComboRow(
            title="Stream compatibility",
            subtitle="Change this if YouTube music keeps cutting out",
            model=Gtk.StringList.new(["Automatic"] + [p[0] for p in PROFILES]))
        combo.set_selected(clamp_int(s["stream_mode"], -1, len(PROFILES) - 1, -1) + 1)
        combo.connect("notify::selected",
                      lambda r, _p: engine.set_stream_mode(r.get_selected() - 1))
        conn.add(combo)

        self.channels_group = Adw.PreferencesGroup(
            title="Sources", description="YouTube live streams, single videos or playlists.")
        page.add(self.channels_group)

        add_group = Adw.PreferencesGroup(title="Add a source")
        page.add(add_group)
        self.name_row = Adw.EntryRow(title="Name (e.g. Jazz radio)")
        self.url_row = Adw.EntryRow(title="YouTube link (video, playlist or live)")
        add_btn = Gtk.Button(icon_name="list-add-symbolic", valign=Gtk.Align.CENTER,
                             css_classes=["flat"], tooltip_text="Add")
        add_btn.connect("clicked", self._on_add)
        self.url_row.add_suffix(add_btn)
        self.url_row.connect("entry-activated", self._on_add)
        add_group.add(self.name_row)
        add_group.add(self.url_row)

        self._snapshot = None
        self._rebuild_channels()
        engine.listeners.append(self._on_engine)
        self.connect("closed", lambda *_: engine.listeners.remove(self._on_engine)
                     if self._on_engine in engine.listeners else None)

    def _on_engine(self, event):
        if event == "settings":
            self._rebuild_channels()

    def _rebuild_channels(self):
        snapshot = json.dumps(self.engine.channels)
        if snapshot == self._snapshot:
            return
        self._snapshot = snapshot
        for row in self._channel_rows:
            self.channels_group.remove(row)
        self._channel_rows = []
        for i, c in enumerate(self.engine.channels):
            row = Adw.ActionRow(title=GLib.markup_escape_text(c["name"]),
                                subtitle=GLib.markup_escape_text(c["url"]),
                                subtitle_lines=1)
            btn = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER,
                             css_classes=["flat"], tooltip_text="Remove")
            btn.connect("clicked", lambda _b, idx=i: self.engine.remove_channel(idx))
            row.add_suffix(btn)
            self.channels_group.add(row)
            self._channel_rows.append(row)
        self.channels_group.set_visible(bool(self._channel_rows))

    def _on_add(self, *_args):
        if self.engine.add_channel(self.name_row.get_text(), self.url_row.get_text()):
            self.name_row.set_text("")
            self.url_row.set_text("")
            self.url_row.remove_css_class("error")
        else:
            self.url_row.add_css_class("error")


