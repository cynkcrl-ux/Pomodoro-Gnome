class PomodoroApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.engine = None
        self.win = None
        self._held = False

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        try:
            provider.load_from_string(CSS)
        except AttributeError:
            provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.engine = Engine(self._notify)
        self.engine.listeners.append(self._on_engine)

        actions = {
            "present": self._present,
            "start-pause": lambda *_: self.engine.start_or_pause(),
            "skip": lambda *_: self.engine.skip(),
            "reset": lambda *_: self.engine.reset(),
            "restart-music": lambda *_: self.engine.replay_music(),
            "preferences": self._show_preferences,
            "about": self._show_about,
            "quit": lambda *_: self.quit(),
        }
        for name, fn in actions.items():
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", fn)
            self.add_action(action)
        self.set_accels_for_action("app.start-pause", ["<primary>space"])
        self.set_accels_for_action("app.preferences", ["<primary>comma"])
        self.set_accels_for_action("app.quit", ["<primary>q"])
        self.set_accels_for_action("window.close", ["<primary>w"])
        self._on_engine("state")

    def do_activate(self):
        self._present()

    def do_shutdown(self):
        if self.engine:
            self.engine.shutdown()
        Adw.Application.do_shutdown(self)

    def _present(self, *_args):
        if self.win is None:
            self.win = PomodoroWindow(self, self.engine)
            self.win.connect("destroy", self._on_win_destroy)
        self.win.set_visible(True)
        self.win.present()

    def _on_win_destroy(self, _win):
        self.win = None

    def _show_preferences(self, *_args):
        self._present()
        PreferencesDialog(self.engine).present(self.win)

    def _show_about(self, *_args):
        self._present()
        dialog = Adw.AboutDialog(
            application_name=APP_NAME,
            application_icon=APP_ID,
            developer_name="Cydrek Carillo",
            version=VERSION,
            comments="A pomodoro timer with YouTube live streams or ambient sounds "
                     "as focus music. Vibe coded GNOME port of omarchy-pomodoro.",
            website=SOURCE_URL,
            copyright="© 2026 Cydrek Carillo © 2026 Alessandro Belli",
            license_type=Gtk.License.MIT_X11,
        )
        dialog.add_acknowledgement_section(
            "Rain recordings (CC0)", ["reg7783 on Freesound", "xkeril on Freesound"])
        dialog.present(self.win)

    def _notify(self, title, body):
        note = Gio.Notification.new(title)
        note.set_body(body)
        note.set_default_action("app.present")
        note.set_priority(Gio.NotificationPriority.HIGH)
        self.send_notification("pomodoro-phase", note)

    def _on_engine(self, _event):
        # Stay alive in the background while a session is running.
        running = bool(self.engine and self.engine.running)
        if running and not self._held:
            self.hold()
            self._held = True
        elif not running and self._held:
            self.release()
            self._held = False


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    return PomodoroApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
