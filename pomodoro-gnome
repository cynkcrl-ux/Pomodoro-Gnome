class Ring(Gtk.Widget):
    """Circular progress, in the accent colour (green during breaks).

    Drawn with GSK nodes only, so it needs no pycairo."""

    __gtype_name__ = "PomodoroRing"
    SIZE = 230
    LINE = 10

    def __init__(self):
        super().__init__()
        self.progress = 0.0
        self.is_break = False
        self.dimmed = False

    def update(self, progress, is_break, dimmed):
        self.progress, self.is_break, self.dimmed = progress, is_break, dimmed
        self.queue_draw()

    def do_measure(self, _orientation, _for_size):
        return (self.SIZE, self.SIZE, -1, -1)

    @staticmethod
    def _rgba(r, g, b, a):
        c = Gdk.RGBA()
        c.red, c.green, c.blue, c.alpha = r, g, b, a
        return c

    def _accent(self):
        name = "success_color" if self.is_break else "accent_color"
        try:
            ok, rgba = self.get_style_context().lookup_color(name)
            if ok:
                return rgba
        except Exception:
            pass
        return self._rgba(0.2, 0.52, 0.89, 1) if not self.is_break else self._rgba(0.2, 0.82, 0.48, 1)

    def do_snapshot(self, snapshot):
        w, h = self.get_width(), self.get_height()
        size = min(w, h)
        x, y = (w - size) / 2.0, (h - size) / 2.0
        rect = Graphene.Rect().init(x, y, size, size)
        rounded = Gsk.RoundedRect()
        rounded.init_from_rect(rect, size / 2.0)
        widths = [float(self.LINE)] * 4

        fg = self.get_color()
        track = self._rgba(fg.red, fg.green, fg.blue, 0.10)
        snapshot.append_border(rounded, widths, [track] * 4)

        if self.progress <= 0:
            return
        p = max(0.0005, min(0.9995, self.progress))
        accent = self._accent()
        if self.dimmed:
            accent = self._rgba(accent.red, accent.green, accent.blue, 0.5)
        clear = self._rgba(accent.red, accent.green, accent.blue, 0.0)
        stops = []
        for offset, color in ((0.0, accent), (p, accent), (p + 0.0005, clear), (1.0, clear)):
            stop = Gsk.ColorStop()
            stop.offset, stop.color = offset, color
            stops.append(stop)
        center = Graphene.Point().init(x + size / 2.0, y + size / 2.0)
        # The conic gradient, cut down to the ring's outline.
        snapshot.push_mask(Gsk.MaskMode.ALPHA)
        snapshot.append_border(rounded, widths, [self._rgba(0, 0, 0, 1)] * 4)
        snapshot.pop()
        snapshot.append_conic_gradient(rect, center, 0.0, stops)
        snapshot.pop()


class PomodoroWindow(Adw.ApplicationWindow):
    def __init__(self, app, engine):
        height = 680
        try:
            monitor = Gdk.Display.get_default().get_monitors().get_item(0)
            height = min(height, int(monitor.get_geometry().height * 0.75))
        except Exception:
            pass
        super().__init__(application=app, title=APP_NAME,
                         default_width=440, default_height=max(420, height))
        self.set_size_request(340, 420)
        self.engine = engine
        self._guard = False
        self._music_rows = []
        self._channel_snapshot = None
        self._radios = {}
        self._radio_leader = Gtk.CheckButton()

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title=APP_NAME, subtitle=""))
        menu = Gio.Menu()
        menu.append("Preferences", "app.preferences")
        menu.append("About Pomodoro", "app.about")
        menu.append("Quit", "app.quit")
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic",
                                       menu_model=menu, primary=True,
                                       tooltip_text="Main Menu"))
        toolbar.add_top_bar(header)

        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      vexpand=True)
        clamp = Adw.Clamp(maximum_size=480, tightening_threshold=400,
                          margin_top=12, margin_bottom=24,
                          margin_start=12, margin_end=12)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        clamp.set_child(page)
        scroller.set_child(clamp)
        toolbar.set_content(scroller)
        self.set_content(toolbar)

        page.append(self._build_timer())
        page.append(self._build_controls())
        page.append(self._build_focus_length())
        self.music_group = Adw.PreferencesGroup(title="Music")
        self.ambient_group = Adw.PreferencesGroup(title="Ambient")
        page.append(self.music_group)
        page.append(self.ambient_group)
        page.append(self._build_volume())

        self.connect("close-request", self._on_close)
        engine.listeners.append(self._on_engine)
        self.connect("destroy", lambda *_: engine.listeners.remove(self._on_engine)
                     if self._on_engine in engine.listeners else None)

        self._rebuild_music()
        self._sync_focus_buttons()
        self._refresh()
        self.play_btn.grab_focus()

    # ---- building ---------------------------------------------------------

    def _build_timer(self):
        self.ring = Ring()
        overlay = Gtk.Overlay(halign=Gtk.Align.CENTER)
        overlay.set_child(self.ring)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                        halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.phase_label = Gtk.Label(css_classes=["heading"])
        self.time_label = Gtk.Label(css_classes=["pomo-time"])
        self.session_label = Gtk.Label(css_classes=["caption", "dim-label"])
        inner.append(self.phase_label)
        inner.append(self.time_label)
        inner.append(self.session_label)
        overlay.add_overlay(inner)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(overlay)
        return box

    def _build_controls(self):
        box = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER)
        self.reset_btn = Gtk.Button(icon_name="edit-undo-symbolic",
                                    css_classes=["circular"], valign=Gtk.Align.CENTER,
                                    tooltip_text="Reset")
        self.play_btn = Gtk.Button(css_classes=["circular", "suggested-action", "pomo-play"],
                                   valign=Gtk.Align.CENTER)
        self.skip_btn = Gtk.Button(icon_name="media-skip-forward-symbolic",
                                   css_classes=["circular"], valign=Gtk.Align.CENTER,
                                   tooltip_text="Skip")
        self.reset_btn.connect("clicked", lambda *_: self.engine.reset())
        self.play_btn.connect("clicked", lambda *_: self.engine.start_or_pause())
        self.skip_btn.connect("clicked", lambda *_: self.engine.skip())
        for b in (self.reset_btn, self.play_btn, self.skip_btn):
            box.append(b)
        return box

    def _build_focus_length(self):
        group = Adw.PreferencesGroup(title="Focus length",
                                     description="Changes apply from the next session.")
        row = Adw.ActionRow(title="Minutes")
        linked = Gtk.Box(css_classes=["linked"], valign=Gtk.Align.CENTER)
        self.preset_buttons = {}
        first = None
        for minutes in PRESETS + ("custom",):
            btn = Gtk.ToggleButton(label=str(minutes) if minutes != "custom" else "Custom")
            if first is None:
                first = btn
            else:
                btn.set_group(first)
            btn.connect("toggled", self._on_preset_toggled, minutes)
            self.preset_buttons[minutes] = btn
            linked.append(btn)
        row.add_suffix(linked)
        group.add(row)

        self.custom_row = Adw.SpinRow(
            title="Custom length", subtitle="Minutes",
            adjustment=Gtk.Adjustment(lower=1, upper=600, step_increment=1,
                                      page_increment=5,
                                      value=self.engine.focus_minutes))
        self.custom_row.connect("notify::value", self._on_custom_changed)
        group.add(self.custom_row)
        return group

    def _build_volume(self):
        group = Adw.PreferencesGroup()
        row = Adw.ActionRow(title="Volume")
        self.volume_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.volume_scale.set_value(self.engine.volume)
        self.volume_scale.set_size_request(160, -1)
        self.volume_scale.set_valign(Gtk.Align.CENTER)
        self.volume_scale.set_draw_value(False)
        self.volume_scale.connect(
            "value-changed", lambda s: self.engine.set_volume(s.get_value()))
        row.add_suffix(self.volume_scale)
        group.add(row)

        restart = Adw.ActionRow(title="Restart music",
                                subtitle="If the audio went quiet, e.g. after a call",
                                activatable=True)
        restart.add_suffix(Gtk.Image(icon_name="view-refresh-symbolic"))
        restart.connect("activated", lambda *_: self.engine.replay_music())
        group.add(restart)
        return group

    # ---- music list -------------------------------------------------------

    def _radio_row(self, group, title, icon, value, subtitle=""):
        row = Adw.ActionRow(title=GLib.markup_escape_text(title),
                            subtitle=GLib.markup_escape_text(subtitle),
                            subtitle_lines=1)
        row.add_prefix(Gtk.Image(icon_name=icon))
        check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
        check.set_group(self._radio_leader)
        check.connect("toggled", self._on_radio_toggled, value)
        row.add_suffix(check)
        row.set_activatable_widget(check)
        group.add(row)
        self._music_rows.append((group, row))
        self._radios[value] = check

    def _rebuild_music(self):
        snapshot = json.dumps(self.engine.channels)
        if snapshot != self._channel_snapshot:
            self._channel_snapshot = snapshot
            for group, row in self._music_rows:
                group.remove(row)
            self._music_rows = []
            self._radios = {}
            for c in self.engine.channels:
                short = re.sub(r"^https?://(www\.)?", "", c["url"])
                self._radio_row(self.music_group, c["name"],
                                "audio-x-generic-symbolic", c["url"], short)
            self.music_group.set_visible(bool(self.engine.channels))
            for amb_id, label, icon, _src in AMBIENT:
                self._radio_row(self.ambient_group, label, icon, "ambient:" + amb_id)
            self._radio_row(self.ambient_group, "No music",
                            "audio-volume-muted-symbolic", "")
        self._guard = True
        active = self._radios.get(self.engine.channel) or self._radios.get("")
        if active:
            active.set_active(True)
        self._guard = False

    def _on_radio_toggled(self, check, value):
        if self._guard or not check.get_active():
            return
        self.engine.set_setting("channel", value)

    # ---- focus length -----------------------------------------------------

    def _sync_focus_buttons(self):
        minutes = self.engine.focus_minutes
        key = minutes if minutes in PRESETS else "custom"
        self._guard = True
        self.preset_buttons[key].set_active(True)
        self.custom_row.set_visible(key == "custom")
        if int(self.custom_row.get_value()) != minutes:
            self.custom_row.set_value(minutes)
        self._guard = False

    def _on_preset_toggled(self, btn, minutes):
        if self._guard or not btn.get_active():
            return
        if minutes == "custom":
            self.custom_row.set_visible(True)
            self.engine.set_setting("focus_minutes", int(self.custom_row.get_value()))
        else:
            self.custom_row.set_visible(False)
            self.engine.set_setting("focus_minutes", minutes)

    def _on_custom_changed(self, row, _pspec):
        if self._guard:
            return
        self.engine.set_setting("focus_minutes", int(row.get_value()))

    # ---- updates ----------------------------------------------------------

    def _on_engine(self, event):
        if event == "settings":
            self._rebuild_music()
            self._sync_focus_buttons()
        self._refresh()

    def _refresh(self):
        e = self.engine
        label = {"idle": "Ready", "focus": "Focus", "break": "Break"}[e.phase]
        time_text = format_time(e.left_ms)
        self.time_label.set_label(time_text)
        self.phase_label.set_label(label)
        session = ""
        if e.phase == "focus":
            session = "Session %d" % (e.sessions_done + 1)
        elif e.phase == "break":
            session = "Session %d" % e.sessions_done
        if e.paused:
            session += (" · " if session else "") + "Paused"
        self.session_label.set_label(session)
        self.session_label.set_visible(bool(session))
        self.ring.update(e.progress, e.phase == "break", e.paused)

        if e.running:
            self.play_btn.set_icon_name("media-playback-pause-symbolic")
            self.play_btn.set_tooltip_text("Pause")
        else:
            self.play_btn.set_icon_name("media-playback-start-symbolic")
            self.play_btn.set_tooltip_text("Resume" if e.paused else "Start")
        self.skip_btn.set_sensitive(e.phase != "idle")
        self.reset_btn.set_sensitive(e.phase != "idle")
        self.set_title("%s · %s" % (time_text, label) if e.phase != "idle" else APP_NAME)

    def _on_close(self, _win):
        # Keep the timer and music going in the background while it runs.
        if self.engine.running:
            self.set_visible(False)
            return True
        return False


class PreferencesDialog(Adw.PreferencesDialog):
    def __init__(self, engine):
        super().__init__(title="Preferences")
        self.engine = engine
        self._channel_rows = []
        s = engine.settings

        page = Adw.PreferencesPage()
        self.add(page)

        timer = Adw.PreferencesGroup(title="Timer")
        page.add(timer)
        brk = Adw.SpinRow(
            title="Break length", subtitle="Minutes",
            adjustment=Gtk.Adjustment(lower=1, upper=120, step_increment=1,
                                      page_increment=5, value=engine.break_minutes))
        brk.connect("notify::value",
                    lambda r, _p: engine.set_setting("break_minutes", int(r.get_value())))
        timer.add(brk)
        for key, title, subtitle in (
            ("stop_music_on_break", "Stop music during breaks",
             "Resumes live when focus starts"),
            ("auto_continue", "Auto-start next focus", "Right after the break"),
            ("chime", "Chime when a timer ends", "Soft two-note sound"),
        ):
            row = Adw.SwitchRow(title=title, subtitle=subtitle, active=bool(s[key]))
            row.connect("notify::active",
                        lambda r, _p, k=key: engine.set_setting(k, r.get_active()))
            timer.add(row)

        self.channels_group = Adw.PreferencesGroup(
            title="Channels", description="YouTube live streams or videos used as focus music.")
        page.add(self.channels_group)

        add_group = Adw.PreferencesGroup(title="Add a channel")
        page.add(add_group)
        self.name_row = Adw.EntryRow(title="Name (e.g. Jazz radio)")
        self.url_row = Adw.EntryRow(title="YouTube link")
        add_btn = Gtk.Button(icon_name="list-add-symbolic", valign=Gtk.Align.CENTER,
                             css_classes=["flat"], tooltip_text="Add")
        add_btn.connect("clicked", self._on_add)
        self.url_row.add_suffix(add_btn)
        self.url_row.connect("entry-activated", self._on_add)
        add_group.add(self.name_row)
        add_group.add(self.url_row)

        self._snapshot = None
        self._rebuild_channels()
        engine.listeners.append(self._on_engine)
        self.connect("closed", lambda *_: engine.listeners.remove(self._on_engine)
                     if self._on_engine in engine.listeners else None)

    def _on_engine(self, event):
        if event == "settings":
            self._rebuild_channels()

    def _rebuild_channels(self):
        snapshot = json.dumps(self.engine.channels)
        if snapshot == self._snapshot:
            return
        self._snapshot = snapshot
        for row in self._channel_rows:
            self.channels_group.remove(row)
        self._channel_rows = []
        for i, c in enumerate(self.engine.channels):
            row = Adw.ActionRow(title=GLib.markup_escape_text(c["name"]),
                                subtitle=GLib.markup_escape_text(c["url"]),
                                subtitle_lines=1)
            btn = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER,
                             css_classes=["flat"], tooltip_text="Remove")
            btn.connect("clicked", lambda _b, idx=i: self.engine.remove_channel(idx))
            row.add_suffix(btn)
            self.channels_group.add(row)
            self._channel_rows.append(row)
        self.channels_group.set_visible(bool(self._channel_rows))

    def _on_add(self, *_args):
        if self.engine.add_channel(self.name_row.get_text(), self.url_row.get_text()):
            self.name_row.set_text("")
            self.url_row.set_text("")
            self.url_row.remove_css_class("error")
        else:
            self.url_row.add_css_class("error")


