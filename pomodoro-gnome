# --------------------------------------------------------------------------
# Paths and small helpers
# --------------------------------------------------------------------------

def _xdg(env, fallback):
    return os.environ.get(env) or os.path.join(os.path.expanduser("~"), fallback)


CONFIG_FILE = os.path.join(_xdg("XDG_CONFIG_HOME", ".config"), "pomodoro-gnome", "settings.json")
STATE_FILE = os.path.join(_xdg("XDG_STATE_HOME", ".local/state"), "pomodoro-gnome", "state.json")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
MPV_SOCKET = os.path.join(RUNTIME_DIR, "pomodoro-gnome-mpv.sock")
MPV_LOG = os.path.join(os.path.dirname(STATE_FILE), "mpv.log")


def find_data(rel):
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [os.path.join(here, "data")]
    candidates.append(os.path.join(GLib.get_user_data_dir(), "pomodoro-gnome"))
    candidates += [os.path.join(d, "pomodoro-gnome") for d in GLib.get_system_data_dirs()]
    for base in candidates:
        path = os.path.join(base, rel)
        if os.path.exists(path):
            return path
    return None


def now_ms():
    return time.time() * 1000.0


def clamp_int(value, low, high, fallback):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return fallback
    return max(low, min(high, n))


def format_time(ms):
    total = max(0, math.ceil(ms / 1000.0))
    return "%02d:%02d" % (total // 60, total % 60)


def read_json(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
        os.replace(tmp, path)
    except OSError:
        pass


def _die_with_parent():
    # So a crash of the app never leaves music playing.
    try:
        import ctypes
        ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except Exception:
        pass


def spawn_quiet(args, die_with_parent=False):
    proc = subprocess.Popen(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        preexec_fn=_die_with_parent if die_with_parent else None,
    )
    return proc


# --------------------------------------------------------------------------
# Engine: timer, persistence and music. No GTK widgets in here.
# --------------------------------------------------------------------------

class Engine:
    def __init__(self, notify):
        self.notify = notify          # notify(title, body)
        self.listeners = []           # fn(event) with event "state" or "settings"
        self.settings = self._load_settings()

        self.phase = "idle"           # idle | focus | break
        self.running = False
        self.ends_at = 0.0
        self.remaining_ms = 0.0
        self.total_ms = 0.0
        self.sessions_done = 0
        self.now_ms = now_ms()

        self.mpv = None
        self.mpv_started = 0.0
        self.playing_channel = None
        self.music_failures = 0
        self._failure_notified = False
        self._watchdog_id = 0
        self._tick_id = 0
        self._retry_id = 0
        self._restart_id = 0

        self._restore_state()
        self._schedule()
        self.sync_music()

    # ---- settings ---------------------------------------------------------

    def _load_settings(self):
        saved = read_json(CONFIG_FILE)
        merged = json.loads(json.dumps(DEFAULT_SETTINGS))
        if isinstance(saved, dict):
            merged.update({k: v for k, v in saved.items() if k in merged})
        if not isinstance(merged["channels"], list):
            merged["channels"] = json.loads(json.dumps(DEFAULT_CHANNELS))
        return merged

    def _save_settings(self):
        write_json(CONFIG_FILE, self.settings)

    @property
    def focus_minutes(self):
        return clamp_int(self.settings["focus_minutes"], 1, 600, 25)

    @property
    def break_minutes(self):
        return clamp_int(self.settings["break_minutes"], 1, 120, 5)

    @property
    def volume(self):
        return clamp_int(self.settings["volume"], 0, 100, 60)

    @property
    def channel(self):
        return self.settings["channel"] or ""

    @property
    def channels(self):
        return [c for c in self.settings["channels"]
                if isinstance(c, dict) and c.get("url")]

    def set_setting(self, key, value):
        self.settings[key] = value
        self._save_settings()
        self.sync_music()
        self._emit("settings")
        self._emit("state")

    def set_volume(self, value):
        value = clamp_int(value, 0, 100, 60)
        self.settings["volume"] = value
        self._save_settings()
        self._mpv_command("set_property", "volume", value)

    def add_channel(self, name, url):
        url = (url or "").strip()
        if not URL_RE.match(url):
            return False
        name = (name or "").strip() or "Channel %d" % (len(self.channels) + 1)
        channels = self.channels + [{"name": name, "url": url}]
        self.settings["channels"] = channels
        if not self.channel:
            self.settings["channel"] = url
        self._save_settings()
        self.sync_music()
        self._emit("settings")
        return True

    def remove_channel(self, index):
        channels = self.channels
        if not 0 <= index < len(channels):
            return
        removed = channels.pop(index)
        self.settings["channels"] = channels
        if removed["url"] == self.channel:
            self.settings["channel"] = channels[0]["url"] if channels else ""
        self._save_settings()
        self.sync_music()
        self._emit("settings")

    def channel_name(self, channel):
        if channel.startswith("ambient:"):
            for amb_id, label, _icon, _src in AMBIENT:
                if channel == "ambient:" + amb_id:
                    return label
        for c in self.channels:
            if c["url"] == channel:
                return c["name"]
        return ""

    # ---- timer ------------------------------------------------------------

    @property
    def paused(self):
        return self.phase != "idle" and not self.running

    @property
    def left_ms(self):
        if self.phase == "idle":
            return self.focus_minutes * 60000.0
        if self.running:
            return max(0.0, self.ends_at - self.now_ms)
        return self.remaining_ms

    @property
    def progress(self):
        if self.phase == "idle" or self.total_ms <= 0:
            return 0.0
        return max(0.0, min(1.0, 1.0 - self.left_ms / self.total_ms))

    def _emit(self, event):
        for fn in list(self.listeners):
            fn(event)

    def _commit(self):
        self._save_state()
        self.sync_music()
        self._schedule()
        self._emit("state")

    def begin_phase(self, nxt):
        minutes = self.break_minutes if nxt == "break" else self.focus_minutes
        self.phase = nxt
        self.total_ms = minutes * 60000.0
        self.remaining_ms = self.total_ms
        self.now_ms = now_ms()
        self.ends_at = self.now_ms + self.remaining_ms
        self.running = True
        self._commit()

    def start_or_pause(self):
        if self.phase == "idle":
            self.begin_phase("focus")
            return
        self.now_ms = now_ms()
        if self.running:
            self.remaining_ms = max(0.0, self.ends_at - self.now_ms)
            self.running = False
        else:
            self.ends_at = self.now_ms + self.remaining_ms
            self.running = True
        self._commit()

    def reset(self):
        self.phase = "idle"
        self.running = False
        self.remaining_ms = 0.0
        self.total_ms = 0.0
        self.sessions_done = 0
        self._commit()

    def skip(self):
        if self.phase != "idle":
            self.finish_phase(silent=True)

    def finish_phase(self, silent=False):
        if self.phase == "focus":
            self.sessions_done += 1
            if not silent:
                self._announce("Focus done",
                               "Take a %d minute break." % self.break_minutes)
            self.begin_phase("break")
        elif self.phase == "break":
            if self.settings["auto_continue"]:
                if not silent:
                    self._announce("Break over",
                                   "Back to focus for %d minutes." % self.focus_minutes)
                self.begin_phase("focus")
            else:
                if not silent:
                    self._announce("Break over",
                                   "Start the next focus session when you're ready.")
                self.phase = "focus"
                self.running = False
                self.total_ms = self.focus_minutes * 60000.0
                self.remaining_ms = self.total_ms
                self._commit()

    def _announce(self, title, body):
        self.notify(title, body)
        if self.settings["chime"]:
            self.play_chime()

    def _schedule(self):
        if self.running and not self._tick_id:
            self._tick_id = GLib.timeout_add(250, self._on_tick)

    def _on_tick(self):
        self.now_ms = now_ms()
        if self.running and self.ends_at - self.now_ms <= 0:
            self.finish_phase()
        else:
            self._emit("state")
        if not self.running:
            self._tick_id = 0
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    # ---- persistence ------------------------------------------------------

    def _save_state(self):
        write_json(STATE_FILE, {
            "phase": self.phase,
            "running": self.running,
            "ends_at": self.ends_at,
            "remaining_ms": self.remaining_ms,
            "total_ms": self.total_ms,
            "sessions_done": self.sessions_done,
        })

    def _restore_state(self):
        saved = read_json(STATE_FILE)
        if not isinstance(saved, dict):
            return
        phase = saved.get("phase")
        if phase not in ("focus", "break"):
            return
        # A phase that ended while the app was closed isn't resumed.
        if saved.get("running") and saved.get("ends_at", 0) <= now_ms():
            return
        self.sessions_done = clamp_int(saved.get("sessions_done"), 0, 10 ** 6, 0)
        self.phase = phase
        self.total_ms = float(saved.get("total_ms") or 0) or (
            (self.break_minutes if phase == "break" else self.focus_minutes) * 60000.0)
        self.now_ms = now_ms()
        if saved.get("running"):
            self.ends_at = float(saved["ends_at"])
            self.remaining_ms = max(0.0, self.ends_at - self.now_ms)
            self.running = True
        else:
            self.remaining_ms = float(saved.get("remaining_ms") or 0)
            self.running = False

    # ---- music ------------------------------------------------------------

    @property
    def music_wanted(self):
        if not self.running or not self.channel:
            return False
        if self.phase == "break" and self.settings["stop_music_on_break"]:
            return False
        return True

    def _source(self, channel):
        if channel.startswith("ambient:"):
            for amb_id, _label, _icon, src in AMBIENT:
                if channel == "ambient:" + amb_id:
                    return find_data(src) if src.startswith("sounds/") else src
            return None
        return channel

    def sync_music(self):
        if self.music_wanted:
            if self.mpv and self.playing_channel != self.channel:
                self._restart_music()
            elif not self.mpv and not self._retry_id and not self._restart_id:
                self._start_music()
        else:
            self._cancel_retry()
            if self.mpv:
                self._stop_music()

    def _cancel_retry(self):
        for attr in ("_retry_id", "_restart_id"):
            source = getattr(self, attr)
            if source:
                GLib.source_remove(source)
                setattr(self, attr, 0)

    def _quit_stale_mpv(self):
        # An mpv left behind by a crash still listens on the socket.
        if not os.path.exists(MPV_SOCKET):
            return
        if self._mpv_command("quit"):
            time.sleep(0.3)

    def _start_music(self):
        channel = self.channel
        source = self._source(channel)
        if not source:
            self.notify("Music stopped", "Couldn't find the sound file.")
            return
        self._quit_stale_mpv()
        try:
            os.makedirs(os.path.dirname(MPV_LOG), exist_ok=True)
        except OSError:
            pass
        args = [
            "mpv", "--no-video", "--no-terminal", "--sid=no", "--loop-file=inf",
            "--ytdl-format=bestaudio/best",
            # Ride out short network drops instead of quitting.
            "--network-timeout=30",
            "--stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=30",
            "--log-file=" + MPV_LOG,
            "--volume=%d" % self.volume,
            "--input-ipc-server=" + MPV_SOCKET,
            "--force-media-title=Pomodoro · " + (self.channel_name(channel) or "music"),
        ]
        args += os.environ.get("POMODORO_MPV_EXTRA", "").split()
        args += ["--", source]
        try:
            proc = spawn_quiet(args, die_with_parent=True)
        except FileNotFoundError:
            self.notify("Music unavailable",
                        "mpv isn't installed. The timer keeps running.")
            return
        self.mpv = proc
        self.mpv_started = time.time()
        self.playing_channel = channel
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid, self._mpv_exited, proc)
        if not self._watchdog_id:
            self._watchdog_id = GLib.timeout_add_seconds(10, self._watchdog)

    def _watchdog(self):
        """Un-pause mpv if something else paused it (e.g. Bluetooth call mode)."""
        if not self.mpv or not self.music_wanted:
            self._watchdog_id = 0
            return GLib.SOURCE_REMOVE
        if self._mpv_get("pause") is True:
            self._mpv_command("set_property", "pause", False)
        return GLib.SOURCE_CONTINUE

    def _stop_music(self):
        proc, self.mpv = self.mpv, None
        self.playing_channel = None
        if proc:
            try:
                proc.terminate()
            except OSError:
                pass

    def _restart_music(self):
        self._stop_music()
        if self._restart_id:
            GLib.source_remove(self._restart_id)
        self._restart_id = GLib.timeout_add(300, self._after_restart)

    def _after_restart(self):
        self._restart_id = 0
        self.sync_music()
        return GLib.SOURCE_REMOVE

    def replay_music(self):
        """For when audio went away under mpv (e.g. Bluetooth call mode)."""
        self.music_failures = 0
        if self.music_wanted:
            self._restart_music()

    def _mpv_exited(self, _pid, _status, proc):
        if proc is not self.mpv:
            return  # we stopped it on purpose
        self.mpv = None
        self.playing_channel = None
        if not self.music_wanted:
            return
        if time.time() - self.mpv_started > 120:
            self.music_failures = 0  # it played fine for a while
            self._failure_notified = False
        self.music_failures += 1
        # Streams drop now and then: keep reconnecting, backing off up to 30 s.
        delay = (1, 3, 5, 10, 30)[min(self.music_failures, 5) - 1]
        self._retry_id = GLib.timeout_add_seconds(delay, self._retry_music)
        if self.music_failures >= 3 and not self._failure_notified:
            self._failure_notified = True
            name = self.channel_name(self.channel) or "the stream"
            self.notify("Music keeps dropping",
                        "Can't hold a connection to %s. Still retrying; "
                        "the timer keeps running." % name)

    def _retry_music(self):
        self._retry_id = 0
        self.sync_music()
        return GLib.SOURCE_REMOVE

    def _mpv_get(self, prop):
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(0.5)
            s.connect(MPV_SOCKET)
            s.sendall(json.dumps({"command": ["get_property", prop],
                                  "request_id": 7}).encode() + b"\n")
            buf = b""
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf += chunk
                for line in buf.split(b"\n"):
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if msg.get("request_id") == 7:
                        s.close()
                        return msg.get("data")
            s.close()
        except OSError:
            pass
        return None

    def _mpv_command(self, *cmd):
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(1)
            s.connect(MPV_SOCKET)
            s.sendall(json.dumps({"command": list(cmd)}).encode() + b"\n")
            s.close()
            return True
        except OSError:
            return False

    def play_chime(self):
        path = find_data("chime.oga")
        if not path:
            return
        for cmd in (["pw-play", "--volume", "0.7", path],
                    ["paplay", path],
                    ["mpv", "--no-video", "--no-terminal", "--volume=70", path]):
            if shutil.which(cmd[0]):
                try:
                    proc = spawn_quiet(cmd)
                    GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid,
                                         lambda *_a: None)
                except OSError:
                    continue
                return

    def shutdown(self):
        if self._watchdog_id:
            GLib.source_remove(self._watchdog_id)
            self._watchdog_id = 0
        self._cancel_retry()
        self._stop_music()


